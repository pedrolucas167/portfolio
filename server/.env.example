# Configurações do Servidor

# Porta do servidor backend
PORT=3001

# Ambiente (development | production)
NODE_ENV=development

# URL do Frontend (para CORS)
FRONTEND_URL=http://localhost:3000

# Email de destino das mensagens
CONTACT_EMAIL=pedro_marques_dev@hotmail.com

# Configurações SMTP (Outlook/Hotmail)
# Para usar com Hotmail/Outlook, você precisa:
# 1. Ativar verificação em duas etapas na sua conta Microsoft
# 2. Gerar uma "Senha de aplicativo" em: https://account.microsoft.com/security
# 3. Usar essa senha gerada no SMTP_PASS

SMTP_HOST=smtp-mail.outlook.com
SMTP_PORT=587
SMTP_USER=pedro_marques_dev@hotmail.com
SMTP_PASS=sua_senha_de_aplicativo_aqui

# Alternativa: Gmail
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=seu-email@gmail.com
# SMTP_PASS=sua-senha-de-app
